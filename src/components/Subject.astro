---
import config from "../../config";
---

<style>
  header {
    grid-row: 1 / span calc(sibling-count() - 1);
    text-align: right;
  }

  h1 {
    position: sticky;
    top: 0;
    padding-block: var(--space);
  }

  p {
    position: sticky;
    top: calc(100dvh - var(--space));
    anchor-name: --subject;
  }
</style>

<header>
  <h1>
    {config.name}
  </h1>
  <p>matous@trca.dev</p>
</header>
