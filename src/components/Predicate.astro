---
const { title } = Astro.props;
---

<style>
  section {
    display: grid;
    padding: var(--space);
    grid-template-columns: var(--column) minmax(0, 1fr);
    grid-column: predicate;
    border-radius: var(--space);
    gap: var(--space);
    background: whitesmoke;
  }

  span {
    position: sticky;
    top: var(--space);
  }
</style>

<section>
  <h2>
    <span>{title}</span>
  </h2>
  <slot />
</section>
