---
const { title } = Astro.props;
---

<style>
  article {
    height: calc(100dvh - 8rem);
    scroll-snap-align: start;
    background: oklch(20% 50% var(--progress));
    color: white;
    padding: var(--space);
    border-radius: var(--space);
    margin-top: var(--space);
  }

  h3 {
    position: sticky;
    top: var(--space);
  }
</style>

<article>
  <h3>{title}</h3>
  <slot />
</article>
