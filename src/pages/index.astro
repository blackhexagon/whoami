---
import Subject from "../components/Subject.astro";
import Predicate from "../components/Predicate.astro";
import Modifier from "../components/Modifier.astro";
import config from "../../config.ts";
---

<style is:global>
  @property --progress {
    syntax: "<angle>";
    inherits: true;
    initial-value: 0deg;
  }

  @font-face {
    font-family: "Goga";
    src: url("/trial/Goga/Goga-Bold-TRIAL.otf") format("opentype");
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --color: oklch(50% 50% var(--progress));
  }

  html {
    scroll-snap-type: y mandatory;
    animation: progress;
    animation-timeline: scroll();
    font-family: "Goga", sans-serif;
    scrollbar-color: white var(--color);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    --space: 2rem;
    --column: 200px;
  }

  body {
    padding-inline: calc(50vw - 600px);
    accent-color: var(--color);
    background: var(--color);
    color: white;
  }

  main {
    display: grid;
    gap: var(--space);
    grid-template-columns: var(--column) minmax(0, 1fr);
    grid-template-areas: "subject predicate";
  }

  footer {
    height: 100dvh;
    scroll-snap-align: start;
  }

  @keyframes progress {
    from {
      --progress: 240deg;
    }
    to {
      --progress: 300deg;
    }
  }
</style>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      type="image/svg+xml"
      rel="shortcut icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 10 10'><circle cx='5' cy='5' r='5' fill='var(--color)' /></svg>"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{config.name}</title>
  </head>
  <body>
    <main>
      <Subject>
        {config.name}
      </Subject>
      {
        config.predicates.map(([predicate, modifiers]) => (
          <Predicate title={predicate}>
            <div>
              {modifiers.map((modifier) => (
                <Modifier title={modifier} />
              ))}
            </div>
          </Predicate>
        ))
      }
    </main>
    <footer>matous.trca@gmail.com</footer>
  </body>
</html>
